generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
}

enum LessonType {
  VIDEO
  TEXT
  PDF
  QUIZ
}

enum QuizType {
  MINI
  FINAL
}

enum AssignmentStatus {
  LOCKED
  WORKING
  REVIEW
  APPROVED
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  name                  String
  password              String
  role                  Role                   @default(STUDENT)
  avatar                String?
  createdAt             DateTime               @default(now())
  deactivatedAt         DateTime?
  sessionVersion        Int                    @default(0)
  progress              Progress[]
  quizAttempts          QuizAttempt[]
  comments              Comment[]
  assignments           Assignment[]
  notifications         Notification[]
  passwordResets        PasswordReset[]
  quizQuestionRevisions QuizQuestionRevision[] @relation("QuizQuestionRevisionEditor")
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Course {
  id          String       @id @default(cuid())
  name        String
  description String?
  order       Int
  icon        String
  color       String
  sections    Section[]
  assignments Assignment[]
}

model Section {
  id       String   @id @default(cuid())
  courseId  String
  course   Course   @relation(fields: [courseId], references: [id])
  title    String
  order    Int
  lessons  Lesson[]
}

model Lesson {
  id        String     @id @default(cuid())
  sectionId String
  section   Section    @relation(fields: [sectionId], references: [id])
  title     String
  type      LessonType
  videoUrl  String?
  content   String?
  pdfUrl    String?
  duration  String?
  order     Int
  progress  Progress[]
  comments  Comment[]
  quizzes   Quiz[]
}

model Progress {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  lessonId       String
  lesson         Lesson    @relation(fields: [lessonId], references: [id])
  completed      Boolean   @default(false)
  watchedSeconds Int       @default(0)
  completedAt    DateTime?

  @@unique([userId, lessonId])
}

model Quiz {
  id        String         @id @default(cuid())
  lessonId  String?
  lesson    Lesson?        @relation(fields: [lessonId], references: [id])
  courseId  String?
  type      QuizType
  title     String
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id           String @id @default(cuid())
  quizId       String
  quiz         Quiz   @relation(fields: [quizId], references: [id])
  question     String
  options      Json
  correctIndex Int
  order        Int
}

// 確認テストの問題の編集履歴（監査用。#81）。問題を消しても履歴は残すため、questionId・quizId は FK にしない。
// editor は編集した講師。履歴が残っている User は削除できない（onDelete: Restrict。受講生・講師の無効化は論理削除）。
model QuizQuestionRevision {
  id            String   @id @default(cuid())
  questionId    String
  quizId        String
  editorId      String
  editor        User     @relation("QuizQuestionRevisionEditor", fields: [editorId], references: [id], onDelete: Restrict)
  changedFields String[]
  before        Json
  after         Json
  createdAt     DateTime @default(now())

  @@index([questionId, createdAt])
  @@index([quizId, createdAt])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id])
  score     Int
  passed    Boolean
  answers   Json
  createdAt DateTime @default(now())
}

model Comment {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  lessonId  String
  lesson    Lesson    @relation(fields: [lessonId], references: [id])
  content   String
  parentId  String?
  parent    Comment?  @relation("Replies", fields: [parentId], references: [id])
  replies   Comment[] @relation("Replies")
  createdAt DateTime  @default(now())
}

model Assignment {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id])
  title     String
  status    AssignmentStatus @default(LOCKED)
  deadline  DateTime?
  feedback  String?
  createdAt DateTime         @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
