# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase PostgreSQL / #8)
# 手元は Supabase CLI のローカル DB を使う。`supabase start` のあと、`supabase status` に出る DB URL
# （127.0.0.1:54322）を DATABASE_URL と DIRECT_URL の両方に入れる（`pgbouncer=true` は付けない）。
# 本番の接続情報はこのリポジトリの .env 系ファイルに置かない。リポジトリの外のファイルに置き、
# 本番マイグレーションの適用のときだけ読み込む（手順は docs/dev-db-setup.md）。
# DB の URL は .env だけに書き、.env.local には書かない（Next.js は .env.local を優先し、
# Prisma の CLI は .env を読むため、混在すると接続先が食い違う）。確認は `npm run db:where`。
DATABASE_URL=
# マイグレーション用の直接接続（prisma/schema.prisma の directUrl）。手元では DATABASE_URL と同じ値
DIRECT_URL=

# NextAuth
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- メール送信（Resend / #9）---
# Vercel の Production にだけ設定する。Preview / Development と手元の .env には設定しない
# （メールは本番からだけ送る。手元や Preview から本物の受講生にメールが届かないようにするため）。
# 必須変数が未設定・不正ならメール送信はスキップされ、変数名だけがログに出る。
# Resend の API キー。送信専用（Sending access）で、ドメイン mail.bws-bennet.com に限定したキーを使う
RESEND_API_KEY=
# 送信元。「表示名 <アドレス>」か「アドレス」。例: Next World Academy <no-reply@mail.bws-bennet.com>
MAIL_FROM=
# リセット URL の基点。https のオリジンのみ（パス・クエリ・フラグメント・ユーザー情報は不可）。例: https://nwa-lms.vercel.app
APP_BASE_URL=
# 任意。Reply-To に使うアドレス（info@bws-bennet.com を想定）
MAIL_REPLY_TO=
