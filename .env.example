# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase PostgreSQL)
DATABASE_URL=
# マイグレーション用の直接接続（prisma/schema.prisma の directUrl）
DIRECT_URL=

# NextAuth
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- メール送信（Resend / #9）---
# Vercel の Production にだけ設定する。Preview / Development には設定しない（開発用 DB と本番 DB が同じため #8）。
# 必須変数が未設定・不正ならメール送信はスキップされ、変数名だけがログに出る。
# Resend の API キー。送信専用（Sending access）で、ドメイン mail.bws-bennet.com に限定したキーを使う
RESEND_API_KEY=
# 送信元。「表示名 <アドレス>」か「アドレス」。例: Next World Academy <no-reply@mail.bws-bennet.com>
MAIL_FROM=
# リセット URL の基点。https のオリジンのみ（パス・クエリ・フラグメント・ユーザー情報は不可）。例: https://nwa-lms.vercel.app
APP_BASE_URL=
# 任意。Reply-To に使うアドレス（info@bws-bennet.com を想定）
MAIL_REPLY_TO=
